---
import Base from '../layouts/Base.astro';
import ScribeForm from '../components/ScribeForm.astro';
import { loadScribeSchema } from '../lib/scribe';
const schema = loadScribeSchema();
---
<Base title="Get a Free Quote — Jack Window Cleaning" description="Request a free window cleaning quote in Lancaster, PA." current="contact">
  <section class="wrap layout">
    <div class="intro">
      <p class="eyebrow">Free quote</p>
      <h1>Let’s get you<br />a clear view.</h1>
      <p class="sub">Tell us a little about your windows and we’ll reply within one business day with a firm price. No obligation.</p>
      <dl>
        <dt>Call</dt><dd>(717) 555-0142</dd>
        <dt>Email</dt><dd>hello@jackwindowcleaning.example</dd>
        <dt>Hours</dt><dd>Mon&ndash;Sat, 7am&ndash;6pm</dd>
        <dt>Area</dt><dd>Lancaster, Lititz, Manheim, Ephrata &amp; nearby</dd>
      </dl>
    </div>
    <div class="panel">
      <ScribeForm site={schema.site} collection="inquiries" turnstileSiteKey={schema.turnstileSiteKey ?? ''} />
    </div>
  </section>
</Base>

<style>
  .layout { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(2rem, 5vw, 4rem); padding-top: clamp(3.5rem, 8vw, 6rem); align-items: start; }
  h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); font-weight: 800; }
  .sub { color: var(--ink-soft); font-size: 1.15rem; margin: 1.25rem 0 2rem; max-width: 30rem; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 0.6rem 1.5rem; margin: 0; }
  dt { font-weight: 700; color: var(--teal); }
  dd { margin: 0; }
  .panel { background: var(--white); border: 1px solid var(--line); border-radius: 26px; padding: clamp(1.5rem, 4vw, 2.5rem); box-shadow: 0 30px 60px -35px rgba(11, 34, 48, 0.4); }
</style>
