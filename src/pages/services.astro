---
import Base from '../layouts/Base.astro';
import { href, loadPackages } from '../lib/scribe';
const packages = loadPackages();
const extras = ['Gutter face & fascia rinse', 'Screen repair & replacement', 'Solar panel cleaning', 'Hard-water stain removal', 'Post-construction cleanup', 'Skylights & hard-to-reach glass'];
---
<Base title="Services & Packages — Jack Window Cleaning" description="Window cleaning packages for homes and businesses in Lancaster, PA." current="services">
  <section class="wrap head">
    <p class="eyebrow">Services &amp; packages</p>
    <h1>Straightforward pricing.<br />Spotless results.</h1>
    <p class="sub">Prices are starting points for a typical home. We confirm an exact quote before we ever pick up a squeegee.</p>
  </section>

  <section class="wrap grid">
    {packages.map((p) => (
      <article class:list={['card', { featured: p.featured }]}>
        {p.featured && <span class="tag">Most popular</span>}
        <h2>{p.title}</h2>
        <p class="tagline">{p.tagline}</p>
        <p class="price">{p.price}</p>
        <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
        <a class:list={['btn', { ghost: !p.featured }]} href={href('contact/')}>Get this quote</a>
      </article>
    ))}
  </section>

  <section class="wrap extras">
    <h2>Add-ons &amp; extras</h2>
    <ul>{extras.map((e) => <li>{e}</li>)}</ul>
  </section>
</Base>

<style>
  .head { padding-top: clamp(3.5rem, 8vw, 6rem); }
  h1 { font-size: clamp(2.6rem, 7vw, 5rem); font-weight: 800; }
  .sub { max-width: 36rem; color: var(--ink-soft); font-size: 1.15rem; margin-top: 1.25rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-top: 3rem; align-items: stretch; }
  .card { position: relative; display: flex; flex-direction: column; background: var(--white); border: 1px solid var(--line); border-radius: 24px; padding: 2rem 1.75rem; }
  .card.featured { background: var(--ink); color: var(--white); transform: translateY(-10px); box-shadow: 0 24px 50px -20px rgba(11, 34, 48, 0.5); }
  .tag { position: absolute; top: -14px; left: 1.5rem; background: var(--sun); color: var(--ink); font: 700 0.78rem var(--display); letter-spacing: 0.08em; text-transform: uppercase; padding: 0.35rem 0.8rem; border-radius: 99px; }
  .card h2 { font-size: 1.7rem; }
  .tagline { color: var(--ink-soft); margin: 0.6rem 0 1.2rem; min-height: 3.3em; }
  .featured .tagline { color: #b9d3d6; }
  .price { font: 800 2rem var(--display); letter-spacing: -0.02em; margin: 0 0 1.2rem; }
  .featured .price { color: var(--sun); }
  ul { list-style: none; padding: 0; margin: 0 0 1.75rem; display: grid; gap: 0.65rem; }
  .card li { padding-left: 1.7rem; position: relative; }
  .card li::before { content: ''; position: absolute; left: 0; top: 0.5em; width: 0.9rem; height: 0.5rem; border-left: 3px solid var(--teal); border-bottom: 3px solid var(--teal); transform: rotate(-45deg) translateY(-30%); }
  .featured li::before { border-color: var(--mint); }
  .card .btn { margin-top: auto; justify-content: center; }
  .featured .btn.ghost { color: var(--white); box-shadow: inset 0 0 0 2px var(--white); }

  .extras { margin-top: clamp(4rem, 8vw, 6rem); padding: 2.5rem; background: var(--glass-deep); border-radius: 24px; }
  .extras h2 { font-size: 1.8rem; margin-bottom: 1.25rem; }
  .extras ul { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin: 0; gap: 0.75rem 1.5rem; }
  .extras li::before { content: '✦ '; color: var(--teal); }
</style>
