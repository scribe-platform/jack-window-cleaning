---
export interface Props {
  site: string;
  collection: string;
  turnstileSiteKey: string;
  apiBase?: string;
}
// Where this Site's forms post. `PUBLIC_SCRIBE_API_URL` is an **organisation**
// variable on the GitHub org that owns this repo, passed to the build by
// `deploy.yml`, and it has **no default in a production build** (RFC 0025).
//
// It used to fall back to the production admin, which is the failure that rule
// exists to end: a `PUBLIC_*` value is inlined into the client bundle at build
// time, so a Site that guessed shipped the wrong endpoint and posted a Visitor's
// message to whichever Scribe the fallback named — noticed, if ever, by a Client
// wondering why nobody replied. Failing the build is the cheap version of that.
//
// GitHub resolves an unset `vars.*` to an empty string rather than leaving it
// undefined, so empty has to count as missing. Dev falls back to a *local*
// admin, never production, so `npm run dev` needs no env file and still cannot
// write to a real Client's database by omission.
function scribeApiBase(): string {
  const configured = import.meta.env.PUBLIC_SCRIBE_API_URL?.trim();
  if (configured) return configured;
  if (import.meta.env.PROD) {
    throw new Error(
      'PUBLIC_SCRIBE_API_URL is unset. Set it as an organisation variable on the GitHub org that owns ' +
        'this repo — it has no default in a production build, so this Site posts nowhere by accident.',
    );
  }
  return 'http://localhost:3040';
}

const { site, collection, turnstileSiteKey, apiBase: apiBaseProp } = Astro.props;

// Resolved after the props, and only when the endpoint was not passed in:
// `scribeApiBase()` throws, and a caller who named the endpoint has already
// answered the question it would throw about. A default in the destructuring
// would evaluate unconditionally and make that escape hatch a lie.
const apiBase = apiBaseProp ?? scribeApiBase();
const formId = `scribe-form-${collection}`;
---
<form id={formId} class="quote" data-site={site} data-collection={collection} data-endpoint={`${apiBase}/api/submissions`} data-scribe-retry>
  <div class="row">
    <label>Your name<input name="name" type="text" required autocomplete="name" /></label>
    <label>Email<input name="email" type="email" required autocomplete="email" /></label>
  </div>
  <div class="row">
    <label>Phone <span class="opt">(optional)</span><input name="phone" type="tel" autocomplete="tel" /></label>
    <label>Package of interest
      <select name="service">
        <option value="">Not sure yet</option>
        <option>The Sparkle</option>
        <option>The Crystal Clear</option>
        <option>The Year-Round</option>
        <option>Storefront &amp; Office</option>
      </select>
    </label>
  </div>
  <label>Tell us about your windows<textarea name="message" rows="5" required placeholder="Roughly how many windows? One story or two? Anything tricky?"></textarea></label>
  <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
  <button type="submit" class="btn">Request my free quote</button>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script is:inline define:vars={{ formId }}>
  (function () {
    const form = document.getElementById(formId);
    if (!form) return;
    const statusEl = form.querySelector('.form-status');
    const say = (m) => { if (statusEl) statusEl.textContent = m; };
    const { site, collection, endpoint } = form.dataset;
    const storageKey = `scribe_pending_submission_${site}_${collection}`;
    const UNREACHABLE = "We couldn't send that yet — it's saved and will retry.";
    const GENERIC = "We couldn't send that. Please try again, or call us instead.";

    const readPending  = () => { try { return JSON.parse(localStorage.getItem(storageKey)) ?? null; } catch { return null; } };
    const savePending  = (p) => { try { localStorage.setItem(storageKey, JSON.stringify(p)); } catch {} };
    const clearPending = ()  => { try { localStorage.removeItem(storageKey); } catch {} };

    function collect() {
      const payload = {};
      for (const el of form.elements) {
        if (!el.name) continue;
        payload[el.name] = el.value;
      }
      return payload;
    }

    async function send(payload) {
      const url = `${endpoint}?site=${encodeURIComponent(site)}&collection=${encodeURIComponent(collection)}`;
      const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (res.ok) return;
      const body = await res.json().catch(() => ({}));
      const error = new Error((body.error ?? '').trim() || GENERIC);
      error.answered = true;
      error.retryable = res.status >= 500;
      throw error;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const payload = collect();
      say('Sending…');
      try {
        await send(payload);
        clearPending();
        form.reset();
        if (window.turnstile) window.turnstile.reset();
        say("Thanks — we got it. Jack will be in touch within one business day.");
      } catch (err) {
        if (err.answered) {
          if (err.retryable) savePending(payload);
          say(err.message);
          return;
        }
        savePending(payload);
        say(UNREACHABLE);
      }
    });

    (async function retryPending() {
      const pending = readPending();
      if (!pending) return;
      try {
        await send(pending);
        clearPending();
        say('Thanks — we got it.');
      } catch (err) {
        if (err.answered && !err.retryable) { clearPending(); say(err.message); }
      }
    })();
  })();
</script>

<style>
  .quote { display: grid; gap: 1.1rem; }
  .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.1rem; }
  label { display: grid; gap: 0.4rem; font-weight: 600; font-size: 0.95rem; }
  .opt { font-weight: 400; opacity: 0.6; }
  input, select, textarea {
    font: 400 1rem var(--body); color: var(--ink);
    padding: 0.85rem 1rem; border-radius: 12px; border: 2px solid var(--line); background: var(--white);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--teal); box-shadow: 0 0 0 4px rgba(27, 138, 138, 0.18); }
  .form-status { margin: 0; min-height: 1.5em; font-weight: 500; color: var(--teal); }
</style>
